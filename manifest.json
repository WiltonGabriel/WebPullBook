{
  "manifest_version": 3,
  "name": "WebPullBook",
  "version": "1.2.1",
  "version_name": "1.2.1-beta",
  "description": "Extract serialized web fiction and multi-chapter pages into clean, volume-organized EPUB ebooks directly in your browser.",
  "homepage_url": "https://github.com/WiltonGabriel/WebPullBook",
  "icons": {
    "16": "icons/icon-16.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_title": "Open WebPullBook",
    "default_icon": {
      "16": "icons/icon-16.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "background": {
    "service_worker": "src/background/service-worker.js",
    "type": "module"
  },
  "permissions": [
    "tabs",
    "storage",
    "downloads",
    "scripting"
  ],
  "host_permissions": [
    "https://*/*",
    "http://*/*"
  ]
}
