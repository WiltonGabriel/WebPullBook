{
  "name": "webpullbook",
  "version": "1.7.1",
  "private": true,
  "type": "module",
  "description": "Zero-dependency Manifest V3 browser extension for Chrome & Firefox that converts web novels, serialized fiction, articles, and open tabs into clean EPUB 2/3, HTML, Markdown, and TXT ebooks.",
  "homepage": "https://github.com/WiltonGabriel/WebPullBook",
  "repository": {
    "type": "git",
    "url": "https://github.com/WiltonGabriel/WebPullBook.git"
  },
  "bugs": {
    "url": "https://github.com/WiltonGabriel/WebPullBook/issues"
  },
  "license": "AGPL-3.0-or-later",
  "keywords": [
    "epub",
    "epub2",
    "epub3",
    "web-to-epub",
    "html-to-epub",
    "ebook-converter",
    "webnovel",
    "light-novel",
    "chrome-extension",
    "firefox-extension",
    "web-extension",
    "manifest-v3",
    "kindle",
    "kobo",
    "calibre",
    "e-ink",
    "offline-reading",
    "readability",
    "browser-extension"
  ],
  "scripts": {
    "lint": "node scripts/check.mjs",
    "lint:biome": "biome lint src scripts tests website/assets/js",
    "lint:amo": "node -e \"import('node:child_process').then(async({execFileSync})=>{const os=await import('node:os'),path=await import('node:path'),fs=await import('node:fs');const z=path.join(os.tmpdir(),'webpullbook-amo-'+process.pid+'.zip');try{execFileSync('zip',['-9','-r',z,'manifest.json','_locales','icons','src','LICENSE','README.md','README.pt.md'],{stdio:'inherit'});execFileSync('addons-linter',[z],{stdio:'inherit'});}finally{fs.rmSync(z,{force:true});}});\"",
    "lint:fix": "node scripts/check.mjs --fix",
    "sync:website": "node scripts/sync-website.mjs",
    "test": "node --test tests/*.test.js",
    "test:epubcheck": "node --test tests/epub-validation.test.js",
    "test:e2e": "node tests/e2e/extension.e2e.mjs",
    "test:e2e:firefox": "node tests/e2e/firefox.e2e.mjs",
    "check": "npm run lint && npm test"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.8",
    "addons-linter": "^10.16.0",
    "fake-indexeddb": "^6.2.8",
    "jsdom": "^31.0.1",
    "playwright": "^1.65.1"
  }
}
